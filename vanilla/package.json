{
  "name": "interactive-rating-component",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:update-snapshots": "playwright test --project=chromium --update-snapshots",
    "test:smoke": "playwright test tests/smoke.spec.ts --project=firefox --project=webkit",
    "check": "pnpm build && pnpm test && pnpm test:smoke"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "dependencies": {
    "@fontsource/overpass": "^5.3.0"
  }
}
